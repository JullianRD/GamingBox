# --- Application ---
APP_FRONTEND_URL=http://localhost:3000
# Générer chaque secret avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Obligatoires en production, 32 caractères minimum
SESSION_SECRET=
CSRF_SECRET=

# --- Serveur ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# --- Base de données ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gamingbox_db_dev
DB_USER=postgres
DB_PASSWORD=your_database_password

# Compte applicatif PostgreSQL (droits restreints)
DB_APP_USER=app_gamingbox
DB_APP_PASSWORD=your_app_database_password

# Connexion utilisée par l'application
DATABASE_URL=postgresql://app_gamingbox:your_app_database_password@localhost:5432/gamingbox_db_dev
# Connexion propriétaire du schéma, utilisée seulement par `npm run migrate` (défaut : DATABASE_URL)
# MIGRATE_DATABASE_URL=postgresql://postgres:your_database_password@localhost:5432/gamingbox_db_dev
# Production : vérification du certificat TLS de la base (laisser "true" si possible)
# DB_SSL_REJECT_UNAUTHORIZED=true

# --- Tests ---
# Base jetable (le nom doit contenir "test") : le schéma y est recréé à chaque exécution
# TEST_DATABASE_URL=postgresql://postgres:your_database_password@localhost:5432/gamingbox_test

# --- IGDB / Twitch ---
IGDB_CLIENT_ID=your_igdb_client_id
IGDB_CLIENT_SECRET=your_igdb_client_secret

# --- Emails (vérification d'adresse, mot de passe oublié, partages) ---
# Sans SMTP_HOST, les emails sont écrits dans les logs (pratique en développement)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="GamingBox <no-reply@example.com>"

# --- Journal d'activité : rétention en jours (défaut 365) ---
# EVENTS_RETENTION_DAYS=365
