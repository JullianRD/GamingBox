# --- Application ---
APP_FRONTEND_URL=http://localhost:3000
SESSION_SECRET=your_session_secret
CSRF_SECRET=your_csrf_secret

# --- Configuration Serveur ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# --- Configuration Base de Données ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cocon_db_dev
DB_USER=postgres
DB_PASSWORD=your_database_password

# --- Compte applicatif PostgreSQL ---
DB_APP_USER=app_cocon
DB_APP_PASSWORD=your_app_database_password

# --- Connection string utilisée par Node.js ---
# En local :
DATABASE_URL=postgresql://postgres:your_database_password@localhost:5432/cocon_db_dev
# Sur Neon : URL avec pooler pour l'app, URL directe pour les migrations
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/cocon?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/cocon?sslmode=require
# Options : DB_SSL=true|false, DB_SSL_REJECT_UNAUTHORIZED=false, DB_POOL_MAX=10

# --- Configuration IGDB / Twitch ---
IGDB_CLIENT_ID=your_igdb_client_id
IGDB_CLIENT_SECRET=your_igdb_client_secret
# --- Tests d'intégration (base vide dédiée, optionnel) ---
TEST_DATABASE_URL=postgresql://postgres:your_database_password@localhost:5432/cocon_db_test
