{
  "name": "gamingbox-light-mvc",
  "version": "1.0.0",
  "description": "GamingBox : liste de jeux vidéo, reviews et partage (alternative à Letterboxd / BacklogGD).",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "migrate": "node scripts/migrate.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.js\" app.js",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.js\" app.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JullianRD/GamingBox.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/JullianRD/GamingBox/issues"
  },
  "homepage": "https://github.com/JullianRD/GamingBox#readme",
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^17.3.1",
    "ejs": "^4.0.1",
    "express": "^5.2.1",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "multer": "^2.1.1",
    "nodemailer": "^10.6.1",
    "pg": "^8.19.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.35.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2"
  },
  "engines": {
    "node": ">=22"
  }
}
