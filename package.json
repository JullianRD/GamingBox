{
  "name": "cocon",
  "version": "1.0.0",
  "description": "Cocon : ta liste de jeux, de films et de lectures, avec tes reviews à partager.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "nodemon app.js",
    "start": "node app.js",
    "test": "node --test --test-concurrency=1",
    "db:migrate": "node scripts/migrate.js up",
    "db:migrate:down": "node scripts/migrate.js down",
    "db:migrate:create": "node-pg-migrate create --migration-file-language sql",
    "build:css": "tailwindcss -i src/styles/app.css -o public/css/app.css --minify",
    "dev:css": "tailwindcss -i src/styles/app.css -o public/css/app.css --watch",
    "prestart": "npm run build:css",
    "predev": "npm run build:css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JullianRD/GamingBox.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/JullianRD/GamingBox/issues"
  },
  "homepage": "https://github.com/JullianRD/GamingBox#readme",
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@tailwindcss/cli": "^4.3.5",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^17.3.1",
    "ejs": "^4.0.1",
    "express": "^5.2.1",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.19.0",
    "fflate": "^0.8.2",
    "helmet": "^8.1.0",
    "htmx.org": "^2.0.11",
    "multer": "^2.1.1",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.19.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.5",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=22"
  }
}
