<%# État vide. Paramètres : title, text, ctaHref?, ctaLabel? %>
<div class="flex flex-col items-center gap-3 rounded-3xl border border-dashed border-line bg-surface px-6 py-10 text-center">
  <p class="m-0 font-serif text-xl"><%= title %></p>
  <p class="m-0 max-w-md text-muted"><%= text %></p>
  <% if (typeof ctaHref !== "undefined" && ctaHref) { %>
    <a href="<%= ctaHref %>" class="btn-primary mt-2"><%= ctaLabel %></a>
  <% } %>
</div>
