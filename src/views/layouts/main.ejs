<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Cocon' %></title>

    <link rel="icon" href="/images/cocon-logo.svg" type="image/svg+xml">

    <!-- Polices Cocon : Fraunces (titres) et Nunito (texte) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Nunito:wght@400;600;700&display=swap">

    <!-- CSS compilé par Tailwind (npm run build:css) -->
    <link rel="stylesheet" href="/css/app.css">
    <link rel="stylesheet" href="/css/main.css">

    <!-- htmx : interactions sans rechargement (statut, note, recherche) -->
    <script src="/vendor/htmx.min.js" defer></script>

    <%- typeof style !== "undefined" ? style : "" %>
</head>

<body class="flex min-h-screen flex-col bg-cream text-ink"
      <% if (typeof section !== "undefined" && section) { %>data-section="<%= section %>"<% } %>
      hx-headers='{"X-CSRF-Token": "<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>"}'>
    <% if (typeof currentUser !== "undefined" && currentUser) { %>
        <%# Connecté : structure d'app, barre latérale sur ordinateur, onglets sur mobile %>
        <div class="flex min-h-screen">
            <%- include('../partials/sidebar') %>
            <div class="flex min-w-0 flex-1 flex-col">
                <% if (currentPath !== "/") { %>
                    <header class="sticky top-0 z-40 lg:hidden"><%- include('../partials/topbar') %></header>
                <% } %>
                <main class="mx-auto w-full max-w-6xl flex-1 px-4 pb-28 pt-6 sm:px-6 lg:px-10 lg:pb-12 lg:pt-8">
                    <%- body %>
                </main>
            </div>
        </div>
        <%- include('../partials/tabbar') %>
    <% } else { %>
        <header class="sticky top-0 z-40">
            <%- include('../partials/navbar') %>
        </header>

        <main class="mx-auto w-full max-w-6xl flex-1 px-4 pb-12 pt-6 sm:px-6">
            <%- body %>
        </main>

        <footer class="mt-auto border-t border-line-soft">
            <%- include('../partials/footer') %>
        </footer>
    <% } %>

    <script src="/js/app.js"></script>
    <%- typeof script !== "undefined" ? script : "" %>
</body>

</html>
