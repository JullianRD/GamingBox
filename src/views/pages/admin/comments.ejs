<div class="flex flex-col gap-8">
  <h1 class="m-0 text-4xl">Commentaires</h1>
  <%- include('../../partials/admin/nav') %>
  <%- include('../../partials/flash') %>
  <% if (!comments.length) { %><p class="m-0 text-muted">Aucun commentaire.</p><% } %>
  <ul class="m-0 flex list-none flex-col gap-3 p-0">
    <% comments.forEach((c) => { %>
      <li class="flex flex-col gap-1 rounded-3xl bg-surface p-4 shadow-soft">
        <p class="m-0 text-sm text-muted"><strong class="text-ink"><%= c.author %></strong> sur <a href="/entrees/<%= c.user_item_id %>"><%= c.title %></a> (fiche de <%= c.owner %>) · <%= timeAgo(c.created_at) %></p>
        <p class="m-0 whitespace-pre-line"><%= c.body %></p>
        <div class="self-end"><%- include('../../partials/admin/delete', { action: `/admin/comments/${c.id_comment}/delete` }) %></div>
      </li>
    <% }) %>
  </ul>
</div>
