<div class="flex flex-col gap-8">
  <h1 class="m-0 text-4xl">Administration</h1>
  <%- include('../../partials/admin/nav') %>
  <%- include('../../partials/flash') %>
  <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
    <%- include('../../components/stat-tile', { value: counts.users, label: "utilisateurs" }) %>
    <%- include('../../components/stat-tile', { value: counts.items, label: "œuvres au catalogue" }) %>
    <%- include('../../components/stat-tile', { value: counts.entries, label: "entrées de liste" }) %>
    <%- include('../../components/stat-tile', { value: counts.lists, label: "listes perso" }) %>
    <%- include('../../components/stat-tile', { value: counts.comments, label: "commentaires" }) %>
    <%- include('../../components/stat-tile', { value: counts.activity_week, label: "activités sur 7 jours" }) %>
  </div>
  <section class="card flex flex-col gap-3">
    <h2 class="m-0 text-2xl">Catalogue par catégorie</h2>
    <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
      <% byType.forEach((row) => { %>
        <li><%- include('../../components/type-chip', { type: row.item_type }) %> <span class="text-sm text-muted"><%= row.count %></span></li>
      <% }) %>
    </ul>
  </section>
</div>
