<div class="flex flex-col gap-8">
  <h1 class="m-0 text-4xl">Utilisateurs</h1>
  <%- include('../../partials/admin/nav') %>
  <%- include('../../partials/flash') %>
  <div class="overflow-x-auto rounded-3xl bg-surface shadow-soft">
    <table class="w-full text-left text-sm">
      <thead class="text-muted"><tr><th class="p-4">Pseudo</th><th class="p-4">Email</th><th class="p-4">Rôle</th><th class="p-4">Profil</th><th class="p-4">Entrées</th><th class="p-4">Inscrit</th><th class="p-4"></th></tr></thead>
      <tbody>
        <% users.forEach((u) => { %>
          <tr class="border-t border-line-soft">
            <td class="p-4 font-bold"><a href="/u/<%= encodeURIComponent(u.pseudo) %>" class="no-underline"><%= u.pseudo %></a></td>
            <td class="p-4"><%= u.email %></td>
            <td class="p-4"><%= u.role_name %></td>
            <td class="p-4"><%= u.is_public ? "public" : "privé" %></td>
            <td class="p-4"><%= u.entries %></td>
            <td class="p-4 text-muted"><%= new Date(u.created_at).toLocaleDateString("fr-FR") %></td>
            <td class="p-4"><% if (u.id_user !== currentUser.id) { %><%- include('../../partials/admin/delete', { action: `/admin/users/${u.id_user}/delete` }) %><% } %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
