<div class="flex min-h-[70vh] items-center justify-center px-4 py-10">
  <div class="w-full max-w-md rounded-2xl border border-purple-500/20 bg-white/5 p-8 shadow-2xl">
    <h1 class="text-2xl font-bold text-white">Mot de passe oublié</h1>
    <p class="mt-2 text-sm text-slate-400">
      Saisis ton adresse email : si un compte existe, tu recevras un lien valable 1 heure.
    </p>

    <% if (flash && flash.error) { %>
      <div role="alert" class="mt-4 rounded-xl border border-red-500/20 bg-red-500/10 px-4 py-3 text-red-300"><%= flash.error %></div>
    <% } %>

    <form action="/forgot-password" method="POST" class="mt-6 space-y-5">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div>
        <label for="email" class="mb-2 block text-sm text-slate-300">Email</label>
        <input id="email" name="email" type="email" required autocomplete="email"
          class="w-full rounded-lg border border-slate-700 bg-slate-900 px-4 py-3 text-white focus:border-purple-500 outline-none">
        <% if (typeof errors !== "undefined" && errors.email) { %><p class="mt-1 text-xs text-red-300"><%= errors.email %></p><% } %>
      </div>
      <button type="submit" class="w-full rounded-lg bg-purple-600 px-5 py-3 font-medium text-white hover:bg-purple-500">Envoyer le lien</button>
    </form>

    <p class="mt-6 text-center text-sm text-slate-400"><a href="/login" class="text-purple-300 hover:text-purple-200">Retour à la connexion</a></p>
  </div>
</div>
