<div class="flex justify-center py-6 sm:py-12">
  <div class="card flex w-full max-w-md flex-col gap-6 p-7 sm:p-9">
    <div class="flex flex-col gap-2">
      <h1 class="m-0 text-4xl">Créer mon cocon</h1>
      <p class="m-0 text-muted">Tes jeux, films, livres et musiques, au même endroit.</p>
    </div>

    <%- include('../../partials/flash') %>

    <form action="/register" method="post" class="flex flex-col gap-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="flex flex-col gap-1.5">
        <label for="pseudo" class="text-sm font-bold">Pseudo</label>
        <input id="pseudo" name="pseudo" type="text" required minlength="3" maxlength="50" autocomplete="username" class="field">
      </div>
      <div class="flex flex-col gap-1.5">
        <label for="email" class="text-sm font-bold">Email</label>
        <input id="email" name="email" type="email" required autocomplete="email" class="field">
      </div>
      <div class="flex flex-col gap-1.5">
        <label for="password" class="text-sm font-bold">Mot de passe</label>
        <input id="password" name="password" type="password" required autocomplete="new-password" aria-describedby="password-aide" class="field">
        <p id="password-aide" class="m-0 px-2 text-xs text-muted">Au moins 8 caractères.</p>
      </div>
      <label class="flex items-start gap-3 text-sm leading-snug">
        <input type="checkbox" name="gdprConsent" required class="mt-0.5 h-4 w-4 shrink-0 accent-[#a9573a]">
        <span>J'accepte que mes données soient utilisées pour faire fonctionner Cocon. Je peux les exporter ou supprimer mon compte à tout moment.</span>
      </label>
      <button type="submit" class="btn-primary mt-2 h-12 w-full">Créer mon compte</button>
    </form>

    <p class="m-0 text-center text-sm text-muted">Déjà un compte ? <a href="/login" class="font-bold">Se connecter</a></p>
  </div>
</div>
