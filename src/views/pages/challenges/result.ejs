<div class="mx-auto flex max-w-4xl flex-col gap-8">
  <div class="flex flex-col gap-1">
    <a href="/defis" class="text-sm font-semibold">Défis</a>
    <h1 class="m-0 text-4xl"><%= result.game === "duel" ? "Le vainqueur" : "Ton score" %></h1>
    <p class="m-0 text-muted"><%= result.game === "duel" ? "Duel" : "Blindtest" %> · <%= result.title %><% if (!result.isMine) { %> · partie de <a href="/u/<%= encodeURIComponent(result.owner.pseudo) %>"><%= result.owner.pseudo %></a><% } %> · <%= timeAgo(result.createdAt) %></p>
  </div>

  <% if (result.game === "duel") { const [champion, ...others] = result.payload.ranking; %>
    <section class="flex flex-wrap items-center gap-6 rounded-[28px] bg-peach p-6 sm:p-8">
      <span class="block aspect-[3/4] w-40 overflow-hidden rounded-3xl bg-surface shadow-cover">
        <% if (champion.imageUrl) { %><img src="<%= champion.imageUrl %>" alt="" class="h-full w-full object-cover"><% } %>
      </span>
      <div class="flex flex-col gap-2">
        <span class="text-sm font-bold uppercase tracking-wide text-accent-ink">Vainqueur sur <%= result.total %></span>
        <p class="m-0 font-serif text-4xl text-accent-ink"><%= champion.title %></p>
        <% if (champion.subtitle) { %><p class="m-0 text-accent-ink/80"><%= champion.subtitle %></p><% } %>
      </div>
    </section>
    <section aria-labelledby="classement-duel" class="flex flex-col gap-3">
      <h2 id="classement-duel" class="m-0 text-2xl">Classement</h2>
      <ol class="m-0 grid gap-2 pl-0 sm:grid-cols-2" start="2" style="list-style: none;">
        <% others.forEach((c, i) => { %>
          <li class="flex items-center gap-3 rounded-2xl bg-surface px-4 py-2 shadow-soft">
            <span class="w-6 text-right font-bold text-muted"><%= i + 2 %></span>
            <% if (c.imageUrl) { %><img src="<%= c.imageUrl %>" alt="" class="h-12 w-9 rounded-lg object-cover"><% } %>
            <span class="flex flex-col"><span class="font-semibold"><%= c.title %></span><% if (c.subtitle) { %><span class="text-xs text-muted"><%= c.subtitle %></span><% } %></span>
          </li>
        <% }) %>
      </ol>
    </section>
  <% } else { %>
    <section class="flex flex-wrap items-center gap-6 rounded-[28px] bg-peach p-6 sm:p-8">
      <p class="m-0 font-serif text-6xl text-accent-ink"><%= result.score %><span class="text-3xl">/<%= result.total %></span></p>
      <p class="m-0 text-lg text-accent-ink"><%= result.score === result.total ? "Sans faute." : result.score >= result.total * 0.7 ? "Très belle oreille." : result.score >= result.total * 0.4 ? "Pas mal du tout." : "La prochaine sera la bonne." %></p>
    </section>
    <section aria-labelledby="recap" class="flex flex-col gap-3">
      <h2 id="recap" class="m-0 text-2xl">Récapitulatif</h2>
      <ol class="m-0 flex flex-col gap-1.5 pl-6">
        <% result.payload.recap.forEach((r) => { %>
          <li><span class="font-semibold <%= r.correct ? 'text-games-ink' : 'text-movies-ink' %>"><%= r.correct ? "Trouvé" : "Raté" %></span> · <%= r.reveal %></li>
        <% }) %>
      </ol>
    </section>
  <% } %>

  <% if (result.isMine) { %>
    <div class="flex flex-wrap gap-3">
      <a href="/defis" class="btn-primary">Rejouer</a>
      <a href="/fil" class="btn-ghost">Voir le fil</a>
    </div>
  <% } %>
</div>
