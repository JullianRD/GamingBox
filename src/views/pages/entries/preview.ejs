<% const t = itemTypes[item.type]; %>
<div class="flex flex-col gap-8">
  <a href="/recherche" class="self-start font-bold no-underline">← Recherche</a>

  <div class="grid grid-cols-[7rem_1fr] gap-x-5 gap-y-6 [grid-template-areas:'cover_head'_'main_main'] sm:grid-cols-[10rem_1fr] lg:grid-cols-[300px_1fr] lg:grid-rows-[auto_1fr] lg:gap-x-12 lg:[grid-template-areas:'cover_head'_'cover_main']">
    <div class="relative aspect-[2/3] self-start overflow-hidden rounded-2xl shadow-cover [grid-area:cover] lg:rounded-[28px] <%= t.tone.cover %>">
      <% if (item.coverUrl) { %>
        <img src="<%= item.coverUrl %>" alt="Jaquette de <%= item.title %>" class="h-full w-full object-cover">
      <% } else { %>
        <span class="absolute inset-x-3 bottom-3 font-serif text-base leading-tight lg:inset-x-6 lg:bottom-6 lg:text-3xl <%= t.tone.ink %>"><%= item.title %></span>
      <% } %>
    </div>

    <div class="flex flex-col gap-2 self-end [grid-area:head] lg:gap-2.5 lg:self-start">
      <%- include('../../components/type-chip', { type: item.type }) %>
      <h1 class="m-0 text-2xl leading-tight sm:text-4xl lg:text-5xl"><%= item.title %></h1>
      <p class="m-0 text-sm text-muted sm:text-base"><%= itemMeta(item) %></p>
    </div>

    <div class="flex min-w-0 flex-col gap-7 [grid-area:main]">

      <form action="/entrees" method="post" class="card flex flex-col gap-4">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="source" value="<%= item.source %>">
        <input type="hidden" name="externalId" value="<%= item.externalId %>">
        <fieldset class="m-0 border-0 p-0">
          <legend class="mb-3 font-bold">Ajouter à ma bibliothèque comme…</legend>
          <div class="flex flex-wrap gap-2.5">
            <% ["planned", "in_progress", "completed"].forEach((status) => { %>
              <button type="submit" name="status" value="<%= status %>"
                      class="min-h-11 rounded-full border-[1.5px] px-5 font-bold <%= status === 'planned' ? 'border-transparent bg-accent text-[#ffffff] hover:bg-accent-ink' : 'border-line bg-surface text-ink hover:bg-cream' %>">
                <%= t.statusLabels[status] %>
              </button>
            <% }) %>
          </div>
        </fieldset>
      </form>
    </div>
  </div>
</div>
