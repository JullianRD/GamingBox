<% /* Gabarit commun des pages d'erreur. Variables : status, message, stack, requestedUrl */ %>
<section class="mx-auto max-w-xl py-16 text-center">
  <p class="text-6xl font-bold text-purple-400"><%= status %></p>
  <h1 class="mt-4 text-2xl font-semibold text-white"><%= heading %></h1>
  <p class="mt-3 text-slate-400"><%= message %></p>
  <% if (typeof stack !== "undefined" && stack) { %>
    <pre class="mt-6 overflow-x-auto rounded-lg bg-slate-900 p-4 text-left text-xs text-red-300"><%= stack %></pre>
  <% } %>
  <div class="mt-8 flex justify-center gap-3">
    <a href="/" class="rounded-lg bg-purple-600 px-5 py-2.5 font-medium text-white hover:bg-purple-500">Accueil</a>
    <a href="/reviews" class="rounded-lg border border-slate-700 px-5 py-2.5 text-slate-200 hover:bg-slate-800">Mes reviews</a>
  </div>
</section>
