<section class="mx-auto max-w-xl py-6">
  <h1 class="text-2xl font-bold text-white"><%= list ? "Modifier la liste" : "Nouvelle liste" %></h1>

  <% if (flash && flash.error) { %><div role="alert" class="mt-4 rounded-xl border border-red-500/20 bg-red-500/10 px-4 py-3 text-red-300"><%= flash.error %></div><% } %>

  <form action="<%= list ? '/lists/' + encodeURIComponent(list.slug) : '/lists' %>" method="POST" class="mt-6 space-y-5 rounded-2xl border border-white/10 bg-white/5 p-6">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div>
      <label for="title" class="mb-1 block text-sm text-slate-300">Titre</label>
      <input id="title" name="title" required minlength="3" maxlength="100" value="<%= list ? list.title : (typeof oldInput !== 'undefined' && oldInput.title) || '' %>"
             class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-white">
      <% if (typeof errors !== "undefined" && errors.title) { %><p class="mt-1 text-xs text-red-300"><%= errors.title %></p><% } %>
    </div>
    <div>
      <label for="description" class="mb-1 block text-sm text-slate-300">Description</label>
      <textarea id="description" name="description" rows="3" maxlength="500" class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-white"><%= list ? list.description || '' : '' %></textarea>
    </div>
    <label class="flex items-center gap-2 text-sm text-slate-300">
      <input type="checkbox" name="isPublic" class="accent-purple-600" <%= list && list.isPublic ? "checked" : "" %>>
      Liste publique (visible si mon profil est public)
    </label>
    <div class="flex justify-end gap-3">
      <a href="<%= list ? '/lists/' + encodeURIComponent(list.slug) : '/lists' %>" class="rounded-lg border border-slate-700 px-4 py-2 text-slate-200 hover:bg-slate-800">Annuler</a>
      <button type="submit" class="rounded-lg bg-purple-600 px-5 py-2 font-medium text-white hover:bg-purple-500">Enregistrer</button>
    </div>
  </form>
</section>
