<section class="mx-auto max-w-3xl py-6">
  <p class="text-sm text-slate-400">Liste de <a class="text-purple-300 hover:text-purple-200" href="/u/<%= encodeURIComponent(list.ownerPseudo) %>"><%= list.ownerPseudo %></a></p>
  <h1 class="mt-1 text-3xl font-bold text-white"><%= list.title %></h1>
  <% if (list.description) { %><p class="mt-2 text-slate-300"><%= list.description %></p><% } %>
  <ol class="mt-6 space-y-3">
    <% items.forEach((item, index) => { %>
      <li class="flex items-center gap-4 rounded-xl border border-white/10 bg-white/5 p-3">
        <span class="w-6 text-center text-slate-500"><%= index + 1 %></span>
        <% if (item.thumbnailUrl) { %><img src="<%= item.thumbnailUrl %>" alt="" class="h-14 w-10 rounded object-cover" loading="lazy"><% } %>
        <div><p class="font-medium text-white"><%= item.gameTitle %></p><p class="text-xs text-slate-400"><%= item.gameGenre %><%= item.note ? " · " + item.note : "" %></p></div>
      </li>
    <% }) %>
  </ol>
</section>
