<div class="flex flex-col gap-8">
  <section class="flex flex-col gap-4">
    <h1 class="m-0 text-4xl">Rechercher</h1>
    <form action="/recherche" method="get" role="search" class="flex max-w-2xl flex-wrap gap-3"
          hx-get="/recherche" hx-target="#search-results" hx-push-url="true" hx-trigger="submit, input changed delay:400ms from:#search-q">
      <label for="search-q" class="sr-only">Titre d'un jeu ou d'un film</label>
      <input id="search-q" name="q" type="search" value="<%= searchQuery %>" placeholder="Hades, Outer Wilds, Dune…" class="field flex-1" autofocus>
      <button type="submit" class="btn-primary">Rechercher</button>
    </form>
    <p class="m-0 text-sm text-muted">Jeux via IGDB. Les films arrivent avec TMDB.</p>
  </section>

  <div id="search-results" aria-live="polite">
    <%- include('../../partials/search/results') %>
  </div>
</div>
