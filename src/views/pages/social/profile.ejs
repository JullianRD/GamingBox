<section class="mx-auto max-w-4xl py-6">
  <header class="flex flex-wrap items-center gap-5">
    <% if (profile.avatar) { %>
      <img src="<%= profile.avatar %>" alt="Avatar de <%= profile.pseudo %>" class="h-24 w-24 rounded-full object-cover">
    <% } else { %>
      <div class="flex h-24 w-24 items-center justify-center rounded-full bg-slate-800 text-3xl font-bold text-slate-300" aria-hidden="true"><%= profile.pseudo.charAt(0).toUpperCase() %></div>
    <% } %>
    <div class="flex-1">
      <h1 class="text-3xl font-bold text-white"><%= profile.pseudo %></h1>
      <p class="text-sm text-slate-400"><%= profile.publicReviews %> reviews · <%= profile.followers %> abonné<%= profile.followers > 1 ? "s" : "" %> · <%= profile.following %> abonnement<%= profile.following > 1 ? "s" : "" %></p>
      <% if (profile.biographie) { %><p class="mt-2 text-slate-300"><%= profile.biographie %></p><% } %>
    </div>
    <% if (user && !isSelf) { %>
      <form action="/u/<%= encodeURIComponent(profile.pseudo) %>/<%= profile.followedByViewer ? 'unfollow' : 'follow' %>" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="rounded-lg <%= profile.followedByViewer ? 'border border-slate-600 text-slate-200' : 'bg-purple-600 text-white hover:bg-purple-500' %> px-4 py-2 text-sm font-medium">
          <%= profile.followedByViewer ? "Ne plus suivre" : "Suivre" %>
        </button>
      </form>
    <% } %>
  </header>

  <% if (lists.length) { %>
    <h2 class="mt-8 text-xl font-semibold text-white">Listes</h2>
    <ul class="mt-3 grid gap-3 sm:grid-cols-2">
      <% lists.forEach((list) => { %>
        <li class="rounded-xl border border-white/10 bg-white/5 p-4">
          <a href="/u/<%= encodeURIComponent(profile.pseudo) %>/lists/<%= encodeURIComponent(list.slug) %>" class="font-medium text-white hover:text-purple-300"><%= list.title %></a>
          <p class="text-xs text-slate-400"><%= list.itemCount %> jeu<%= list.itemCount > 1 ? "x" : "" %></p>
        </li>
      <% }) %>
    </ul>
  <% } %>

  <h2 class="mt-8 text-xl font-semibold text-white">Reviews publiques</h2>
  <% if (!reviews.items.length) { %><p class="mt-3 text-slate-400">Aucune review publique.</p><% } %>
  <div class="mt-3 space-y-3">
    <% reviews.items.forEach((review) => { %><%- include('../../partials/review-card', { review }) %><% }) %>
  </div>

  <% if (reviews.total > page * 12 || page > 1) { %>
    <nav class="mt-6 flex justify-center gap-3 text-sm" aria-label="Pagination">
      <% if (page > 1) { %><a class="rounded-lg border border-slate-700 px-3 py-2 text-slate-200" href="?page=<%= page - 1 %>" rel="prev">Précédent</a><% } %>
      <% if (reviews.total > page * 12) { %><a class="rounded-lg border border-slate-700 px-3 py-2 text-slate-200" href="?page=<%= page + 1 %>" rel="next">Suivant</a><% } %>
    </nav>
  <% } %>
</section>
