<nav aria-label="Administration" class="flex flex-wrap gap-2">
  <% adminTabs.forEach((tab) => { const on = currentPath === tab.href; %>
    <a href="<%= tab.href %>" class="rounded-full px-4 py-2 font-semibold no-underline <%= on ? 'bg-peach text-accent-ink' : 'bg-surface text-muted hover:text-ink' %>" <%= on ? 'aria-current=page' : '' %>><%= tab.label %></a>
  <% }) %>
</nav>
