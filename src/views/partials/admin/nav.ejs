<%# Onglets de l'administration : défilement horizontal sur mobile %>
<nav aria-label="Administration" class="chip-row">
  <% adminTabs.forEach((tab) => { const on = tab.href === "/admin" ? currentPath === "/admin" : currentPath.startsWith(tab.href); %>
    <a href="<%= tab.href %>" class="rounded-full px-4 py-2 font-semibold no-underline <%= on ? 'bg-peach text-accent-ink' : 'bg-surface text-muted hover:text-ink' %>" <%= on ? 'aria-current=page' : '' %>><%= tab.label %></a>
  <% }) %>
</nav>
