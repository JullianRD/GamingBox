<%#
  Recommander l'œuvre d'une fiche à des amis.
  Paramètres : entry, friends, alreadySent (Set d'ids), sent? (amis touchés), error?
%>
<section id="recommander" class="card flex flex-col gap-3" aria-labelledby="recommander-titre">
  <h2 id="recommander-titre" class="m-0 text-xl">Recommander à un ami</h2>
  <% if (typeof sent !== "undefined" && sent.length) { %>
    <p class="m-0 rounded-2xl bg-games px-4 py-2 text-sm font-semibold text-games-ink" role="status">Envoyé à <%= sent.map((f) => f.pseudo).join(", ") %>.</p>
  <% } %>
  <% if (typeof error !== "undefined" && error) { %>
    <p class="m-0 rounded-2xl bg-movies px-4 py-2 text-sm font-semibold text-movies-ink" role="alert"><%= error %></p>
  <% } %>
  <% if (!friends.length) { %>
    <p class="m-0 text-sm text-muted">Quand vous vous suivez mutuellement avec quelqu'un, vous devenez amis et pouvez vous recommander des œuvres. <a href="/amis">Mes amis</a></p>
  <% } else { %>
    <form action="<%= entry.href %>/recommander" method="post" hx-post="<%= entry.href %>/recommander" hx-target="#recommander" hx-swap="outerHTML" class="flex flex-col gap-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <fieldset class="m-0 flex flex-wrap gap-2 border-0 p-0">
        <legend class="sr-only">Amis</legend>
        <% friends.forEach((f) => { const done = alreadySent.has(f.id); %>
          <label class="cursor-pointer">
            <input type="checkbox" name="friends" value="<%= f.id %>" class="peer sr-only">
            <span class="inline-flex items-center gap-2 rounded-full bg-cream py-1 pl-1 pr-3 text-sm font-semibold text-muted peer-checked:bg-peach peer-checked:text-accent-ink peer-focus-visible:outline peer-focus-visible:outline-2">
              <%- include('../social/avatar', { user: f, size: "h-7 w-7 text-[10px]" }) %><%= f.pseudo %><% if (done) { %> <span class="font-normal">(déjà envoyé)</span><% } %>
            </span>
          </label>
        <% }) %>
      </fieldset>
      <label for="reco-message" class="sr-only">Un mot (facultatif)</label>
      <textarea id="reco-message" name="message" rows="2" maxlength="500" placeholder="Un mot pour dire pourquoi (facultatif)" class="field rounded-2xl"></textarea>
      <button type="submit" class="btn-primary self-start">Recommander</button>
    </form>
  <% } %>
</section>
