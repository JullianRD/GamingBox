<%#
  Bloc « Pour toi aujourd'hui » de l'accueil, rechargé par catégorie.
  Paramètres : picks, currentType (code ou null), types (catégories qui ont des suggestions)
%>
<div id="pour-toi-bloc" class="flex flex-col gap-4">
  <% if (types.length > 1) { %>
    <div class="flex flex-wrap gap-1.5" role="group" aria-label="Catégorie des suggestions">
      <% [{ code: null, plural: "Tout" }, ...types].forEach((t) => { const on = (currentType || null) === t.code; %>
        <button type="button" aria-pressed="<%= on %>"
                hx-get="/decouvrir/du-jour<%= t.code ? `?type=${t.code}` : '' %>" hx-target="#pour-toi-bloc" hx-swap="outerHTML"
                class="h-9 cursor-pointer rounded-full border-0 px-4 text-sm font-bold <%= on ? 'bg-ink text-[#ffffff]' : 'bg-surface text-muted shadow-[inset_0_0_0_1px_var(--color-line-soft)] hover:text-ink' %>"><%= t.plural %></button>
      <% }) %>
    </div>
  <% } %>
  <% if (picks.length) { %>
    <div class="-mx-4 flex snap-x gap-4 overflow-x-auto px-4 pb-1 sm:mx-0 sm:grid sm:grid-cols-3 sm:overflow-visible sm:px-0 lg:grid-cols-5">
      <% picks.slice(0, 5).forEach((item) => { %>
        <div class="w-32 shrink-0 snap-start sm:w-auto"><%- include('../../components/cover-card', { item }) %></div>
      <% }) %>
    </div>
  <% } else { %>
    <p class="m-0 rounded-3xl bg-surface px-5 py-4 text-muted">Note ou mets en favori quelques œuvres : tes suggestions du jour apparaîtront ici.</p>
  <% } %>
</div>
