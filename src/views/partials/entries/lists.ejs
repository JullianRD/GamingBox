<%# Listes perso depuis la fiche. Paramètres : entry, lists %>
<div id="entry-lists" class="flex flex-col gap-2.5">
  <span class="font-bold">Dans mes listes</span>
  <% if (lists.length) { %>
    <div class="flex flex-wrap gap-2">
      <% lists.forEach((list) => { %>
        <button type="button" hx-post="<%= entry.href %>/listes/<%= list.id %>" hx-target="#entry-lists" hx-swap="outerHTML"
                aria-pressed="<%= list.contains %>"
                class="min-h-9 rounded-full border-[1.5px] px-3.5 text-sm font-semibold <%= list.contains ? 'border-transparent bg-section text-section-ink' : 'border-line bg-surface text-ink hover:bg-cream' %>">
          <%= list.contains ? "✓ " : "+ " %><%= list.title %>
        </button>
      <% }) %>
    </div>
  <% } else { %>
    <p class="m-0 text-sm text-muted">Tu n'as pas encore de liste. <a href="/listes">Créer une liste</a></p>
  <% } %>
</div>
