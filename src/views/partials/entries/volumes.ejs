<%# Collection de tomes (manga). Paramètre : volumes (VolumeService.get) %>
<% const v = volumes; const action = `${v.entry.href}/tomes`; const stateLabel = { none: "pas encore", owned: "possédé", read: "lu" }; %>
<section id="tomes" aria-labelledby="tomes-titre" class="flex flex-col gap-4 rounded-3xl bg-surface p-5 shadow-soft" hx-target="#tomes" hx-swap="outerHTML">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 id="tomes-titre" class="m-0 text-xl">Mes tomes</h2>
    <% if (v.total) { %>
      <p class="m-0 text-sm text-muted"><strong class="text-ink"><%= v.owned %></strong> possédés · <strong class="text-ink"><%= v.read %></strong> lus sur <%= v.total %></p>
    <% } %>
  </div>

  <% if (v.total) { %>
    <div class="h-2 overflow-hidden rounded-full bg-cream" aria-hidden="true">
      <div class="h-full rounded-full bg-anime-ink" style="width: <%= Math.round((v.owned / v.total) * 100) %>%"></div>
    </div>

    <form action="<%= action %>" method="post" hx-post="<%= action %>" class="m-0">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <ul class="m-0 grid list-none grid-cols-[repeat(auto-fill,minmax(2.75rem,1fr))] gap-2 p-0">
        <% v.volumes.forEach((vol) => { %>
          <li>
            <button type="submit" name="number" value="<%= vol.number %>" title="Tome <%= vol.number %> : <%= stateLabel[vol.state] %>"
                    aria-label="Tome <%= vol.number %>, <%= stateLabel[vol.state] %>. Changer l'état"
                    class="flex h-11 w-full cursor-pointer items-center justify-center rounded-xl text-sm font-extrabold transition
                           <%= vol.state === 'read' ? 'border-0 bg-anime-ink text-[#ffffff]' : vol.state === 'owned' ? 'border-0 bg-anime text-anime-ink' : 'border-[1.5px] border-dashed border-line bg-transparent text-muted hover:border-anime-ink' %>">
              <%= vol.number %>
            </button>
          </li>
        <% }) %>
      </ul>
    </form>

    <p class="m-0 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-muted">
      <span>Un clic : possédé, puis lu, puis retiré.</span>
      <span class="inline-flex items-center gap-1.5"><span class="h-3 w-3 rounded bg-anime" aria-hidden="true"></span>Possédé</span>
      <span class="inline-flex items-center gap-1.5"><span class="h-3 w-3 rounded bg-anime-ink" aria-hidden="true"></span>Lu</span>
    </p>
  <% } else { %>
    <p class="m-0 text-sm text-muted">Le catalogue ne donne pas le nombre de tomes de cette série. Indique-le pour suivre ta collection.</p>
  <% } %>

  <div class="flex flex-wrap gap-3 border-t border-line-soft pt-4">
    <form action="<%= action %>" method="post" hx-post="<%= action %>" class="m-0 flex items-end gap-2">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="action" value="total">
      <label class="flex flex-col gap-1 text-xs font-bold">Nombre de tomes
        <input name="total" type="number" min="1" max="500" required value="<%= v.total || '' %>" class="field w-24 px-4 py-2">
      </label>
      <button type="submit" class="btn border-[1.5px] border-line bg-surface text-sm text-ink hover:bg-cream">Mettre à jour</button>
    </form>
    <% if (v.total) { %>
      <form action="<%= action %>" method="post" hx-post="<%= action %>" class="m-0 flex items-end gap-2">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="action" value="jusqua">
        <label class="flex flex-col gap-1 text-xs font-bold">Possédés jusqu'au tome
          <input name="upTo" type="number" min="1" max="<%= v.total %>" required class="field w-24 px-4 py-2">
        </label>
        <button type="submit" class="btn border-[1.5px] border-line bg-surface text-sm text-ink hover:bg-cream">Cocher</button>
      </form>
    <% } %>
  </div>
</section>
