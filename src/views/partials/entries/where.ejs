<%# « Où le regarder » (films, séries). Paramètre : item %>
<% const meta = item.metadata || item.itemMetadata || {}; %>
<% if (meta.watchProviders && meta.watchProviders.length) { %>
  <div class="flex flex-col gap-2.5 rounded-[20px] bg-surface px-5 py-4 shadow-soft">
    <span class="text-sm font-bold text-muted">Où le regarder en France</span>
    <div class="flex flex-wrap gap-2">
      <% meta.watchProviders.forEach((name) => { %>
        <span class="rounded-full border border-line bg-cream px-3.5 py-1.5 text-sm font-semibold"><%= name %></span>
      <% }) %>
    </div>
    <% if (meta.watchLink) { %><a href="<%= meta.watchLink %>" rel="noopener" target="_blank" class="text-xs font-semibold">Voir les offres (JustWatch via TMDB)</a><% } %>
  </div>
<% } %>
