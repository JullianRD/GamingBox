<%# Progression d'un import en cours, rafraîchie par htmx. Paramètre : current %>
<% const pct = current.total ? Math.round((current.processed / Math.max(1, current.status === "applying" ? (current.counts.matched ?? 0) + (current.counts.applied ?? 0) : current.total)) * 100) : 0; %>
<section id="import-progress" class="card flex flex-col gap-4"
         hx-get="/imports/<%= current.id %>/progression?statut=<%= current.status %>" hx-trigger="every 2s" hx-swap="outerHTML">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 class="m-0 text-2xl"><%= current.status === "matching" ? "On cherche tes œuvres dans le catalogue" : "On remplit ta bibliothèque" %></h2>
    <span class="font-bold text-muted"><%= current.processed %> / <%= current.status === "applying" ? (current.counts.matched ?? 0) + (current.counts.applied ?? 0) : current.total %></span>
  </div>
  <div class="h-2.5 rounded-full bg-line-soft" role="progressbar" aria-valuenow="<%= Math.min(100, pct) %>" aria-valuemin="0" aria-valuemax="100" aria-label="Progression de l'import">
    <div class="h-2.5 rounded-full bg-terracotta transition-all" style="width: <%= Math.min(100, pct) %>%"></div>
  </div>
  <p class="m-0 text-sm text-muted">Tu peux quitter la page : l'import continue et t'attend ici.</p>
</section>
