<%# Accès aux recommandations reçues, avec pastille des non lues %>
<a href="/recommandations" aria-label="Recommandations reçues<%= unseenRecommendations ? ` (${unseenRecommendations} nouvelles)` : '' %>"
   class="relative flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-line-soft bg-surface text-ink no-underline">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- navIcons.inbox %></svg>
  <% if (unseenRecommendations) { %><span class="absolute -right-0.5 -top-0.5 flex h-5 min-w-5 items-center justify-center rounded-full bg-terracotta px-1 text-xs font-bold text-[#ffffff]"><%= unseenRecommendations > 9 ? "9+" : unseenRecommendations %></span><% } %>
</a>
