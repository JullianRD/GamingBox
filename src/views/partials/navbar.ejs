<%
  const path = typeof currentPath !== "undefined" ? currentPath : "/";
  const sectionPath = typeof section !== "undefined" && section && itemTypes[section] ? itemTypes[section].path : null;
  const byPath = (prefix) => (prefix === "/" ? path === "/" : path.startsWith(prefix));
  // Une fiche (/entrees/...) allume l'onglet de sa catégorie
  const isActive = (prefix) => byPath(prefix) || (!sections.some((s) => byPath(s.href)) && prefix === sectionPath);
  const sections = [
    { href: "/", label: "Accueil", tone: "bg-peach text-accent-ink" },
    { href: "/jeux", label: "Jeux", tone: "bg-games text-games-ink" },
    { href: "/films", label: "Films", tone: "bg-movies text-movies-ink" },
    { href: "/listes", label: "Listes", tone: "bg-peach text-accent-ink" },
  ];
%>
<div class="border-b border-line-soft bg-surface/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-3 px-4 py-3 sm:px-6">
    <a href="/" class="flex items-center gap-2.5 text-ink no-underline hover:text-ink">
      <img src="/images/cocon-logo.svg" alt="" width="32" height="32">
      <span class="font-serif text-2xl font-semibold">Cocon</span>
    </a>

    <% if (currentUser) { %>
      <nav aria-label="Sections" class="hidden items-center gap-1 md:flex">
        <% sections.forEach((s) => { %>
          <a href="<%= s.href %>"
             class="rounded-full px-4 py-2.5 font-semibold no-underline <%= isActive(s.href) ? s.tone + ' font-bold' : 'text-muted hover:bg-cream hover:text-ink' %>"
             <%= isActive(s.href) ? 'aria-current=page' : '' %>><%= s.label %></a>
        <% }) %>
        <span class="rounded-full px-4 py-2.5 font-semibold text-muted">
          Livres <span class="ml-1 rounded-full bg-books px-2 py-0.5 text-xs text-books-ink">bientôt</span>
        </span>
      </nav>

      <div class="ml-auto flex flex-1 items-center justify-end gap-3">
        <form action="/recherche" method="get" role="search" class="hidden max-w-xs flex-1 sm:block">
          <label for="nav-search" class="sr-only">Rechercher</label>
          <input id="nav-search" name="q" type="search" placeholder="Un jeu, un film…" class="field py-2.5"
                 value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
        </form>
        <a href="/profile" aria-label="Mon profil"
           class="flex h-11 w-11 items-center justify-center rounded-full bg-games font-bold text-games-ink no-underline">
          <%= (currentUser.pseudo || "?").slice(0, 2).toUpperCase() %>
        </a>
      </div>
    <% } else { %>
      <div class="ml-auto flex items-center gap-3">
        <a href="/login" class="btn-ghost">Se connecter</a>
        <a href="/register" class="btn-primary">Créer un compte</a>
      </div>
    <% } %>
  </div>
</div>
