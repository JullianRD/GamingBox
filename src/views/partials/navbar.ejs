<%# En-tête des pages visiteur (les pages connectées utilisent la barre latérale et les onglets) %>
<div class="border-b border-line-soft bg-surface/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-3 sm:px-6">
    <a href="/" class="mr-auto flex items-center gap-2.5 text-ink no-underline hover:text-ink">
      <img src="/images/cocon-logo.svg" alt="" width="32" height="32">
      <span class="font-serif text-2xl font-semibold">Cocon</span>
    </a>
    <a href="/login" class="btn-ghost <%= currentPath === '/login' ? 'hidden sm:inline-flex' : '' %>">Se connecter</a>
    <a href="/register" class="btn-primary hidden sm:inline-flex">Créer un compte</a>
  </div>
</div>
