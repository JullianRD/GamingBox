<% if (typeof people !== "undefined" && people.length) { %>
  <section aria-labelledby="profils" class="mb-8 flex flex-col gap-3">
    <h2 id="profils" class="m-0 text-2xl">Profils</h2>
    <ul class="m-0 flex list-none flex-wrap gap-3 p-0">
      <% people.forEach((person) => { %>
        <li>
          <a href="<%= person.href %>" class="flex items-center gap-3 rounded-full bg-surface py-2 pl-2 pr-5 text-ink no-underline shadow-soft hover:text-ink">
            <%- include('../social/avatar', { user: person, size: "h-10 w-10 text-xs" }) %>
            <span class="font-bold"><%= person.pseudo %></span>
          </a>
        </li>
      <% }) %>
    </ul>
  </section>
<% } %>
<% if (typeof unavailable !== "undefined" && unavailable.length) { %>
  <p class="mb-6 rounded-2xl bg-books px-5 py-3 text-sm font-semibold text-books-ink">Indisponible pour le moment : <%= unavailable.join(", ") %>.</p>
<% } %>
<% if (searchQuery.length < minLength) { %>
  <p class="m-0 text-muted">Tape au moins <%= minLength %> caractères.</p>
<% } else if (!results.length) { %>
  <%- include('../../components/empty-state', { title: "Aucun résultat", text: `Rien trouvé pour « ${searchQuery} ».` }) %>
<% } else { %>
  <div class="grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-5">
    <% results.forEach((item) => { %>
      <%- include('../../components/cover-card', { item }) %>
    <% }) %>
  </div>
<% } %>
