<%# Commentaires d'une entrée. Paramètres : entryId, comments %>
<div id="comments" class="flex flex-col gap-4">
  <% if (comments.length) { %>
    <ul class="m-0 flex list-none flex-col gap-3 p-0">
      <% comments.forEach((c) => { %>
        <li class="flex gap-3">
          <a href="<%= c.author.href %>" class="no-underline"><%- include('avatar', { user: c.author, size: "h-10 w-10 text-xs" }) %></a>
          <div class="flex min-w-0 flex-1 flex-col gap-1 rounded-2xl bg-surface px-4 py-3 shadow-soft">
            <div class="flex flex-wrap items-center gap-2 text-sm">
              <a href="<%= c.author.href %>" class="font-bold text-ink no-underline"><%= c.author.pseudo %></a>
              <span class="text-muted"><%= timeAgo(c.createdAt) %></span>
              <% if (currentUser && (c.author.id === currentUser.id || (typeof ownerId !== "undefined" && ownerId === currentUser.id))) { %>
                <button type="button" hx-post="/commentaires/<%= c.id %>/supprimer" hx-target="#comments" hx-swap="outerHTML"
                        class="ml-auto bg-transparent p-0 text-xs font-semibold text-muted underline hover:text-ink">Supprimer</button>
              <% } %>
              <% if (currentUser && c.author.id !== currentUser.id) { %>
                <a href="/signaler?type=comment&id=<%= c.id %>" class="<%= (typeof ownerId !== "undefined" && ownerId === currentUser.id) ? '' : 'ml-auto' %> text-xs font-semibold text-muted underline hover:text-ink">Signaler</a>
              <% } %>
            </div>
            <p class="m-0 whitespace-pre-line leading-relaxed"><%= c.body %></p>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <p class="m-0 text-muted">Pas encore de commentaire.</p>
  <% } %>
  <form hx-post="/entrees/<%= entryId %>/commentaires" hx-target="#comments" hx-swap="outerHTML" class="flex flex-col gap-2">
    <label for="comment-body" class="sr-only">Ton commentaire</label>
    <textarea id="comment-body" name="body" rows="2" maxlength="2000" required placeholder="Écrire un commentaire…"
              class="w-full resize-y rounded-[20px] border border-line bg-[#ffffff] px-4 py-3 leading-relaxed text-ink"></textarea>
    <p id="comment-error" role="alert" class="m-0 text-sm font-semibold text-[#9b2c2c] empty:hidden"></p>
    <button type="submit" class="btn-primary self-start">Commenter</button>
  </form>
</div>
