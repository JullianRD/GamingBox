<%
  const icons = {
    "/": '<path d="M3 11.5 12 4l9 7.5"/><path d="M5 10v10h14V10"/>',
    "/bibliotheque": '<rect x="4" y="4" width="4" height="16" rx="1"/><rect x="10" y="4" width="4" height="16" rx="1"/><path d="m16.5 5.5 3.5-.9 3 14.6-3.5.8z" transform="translate(-2 0)"/>',
    "/fil": '<path d="M4 6h16M4 12h16M4 18h10"/>',
    "/listes": '<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>',
    "/defis": '<path d="M8 4h8v5a4 4 0 0 1-8 0z"/><path d="M8 6H5v1a3 3 0 0 0 3 3M16 6h3v1a3 3 0 0 1-3 3M12 13v4M8 20h8"/>',
  };
%>
<nav aria-label="Navigation principale"
     class="fixed inset-x-0 bottom-0 z-50 border-t border-line-soft bg-surface/95 pb-[env(safe-area-inset-bottom)] backdrop-blur lg:hidden">
  <ul class="m-0 grid list-none grid-cols-5 p-0">
    <% navItems.forEach((t) => { %>
      <li>
        <a href="<%= t.href %>"
           class="flex min-h-14 flex-col items-center justify-center gap-0.5 text-xs font-semibold no-underline <%= t.active ? 'text-accent-ink' : 'text-muted' %>"
           <%= t.active ? 'aria-current=page' : '' %>>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- icons[t.href] %></svg>
          <%= t.short || t.label %>
        </a>
      </li>
    <% }) %>
  </ul>
</nav>
