<%
  const tabPath = typeof currentPath !== "undefined" ? currentPath : "/";
  const tabs = [
    { href: "/", label: "Accueil", icon: '<path d="M3 11.5 12 4l9 7.5"/><path d="M5 10v10h14V10"/>' },
    { href: "/jeux", label: "Jeux", icon: '<rect x="2.5" y="7" width="19" height="11" rx="5"/><path d="M7.5 11v3M6 12.5h3"/><circle cx="16" cy="12" r="1"/><circle cx="18" cy="14" r="1"/>' },
    { href: "/films", label: "Films", icon: '<rect x="3" y="4" width="18" height="16" rx="3"/><path d="M7 4v16M17 4v16M3 9h4M17 9h4M3 15h4M17 15h4"/>' },
    { href: "/recherche", label: "Recherche", icon: '<circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/>' },
    { href: "/profile", label: "Profil", icon: '<circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/>' },
  ];
  const tabActive = (href) => (href === "/" ? tabPath === "/" : tabPath.startsWith(href));
%>
<nav aria-label="Navigation principale"
     class="fixed inset-x-0 bottom-0 z-50 border-t border-line-soft bg-surface/95 pb-[env(safe-area-inset-bottom)] backdrop-blur md:hidden">
  <ul class="m-0 grid list-none grid-cols-5 p-0">
    <% tabs.forEach((t) => { %>
      <li>
        <a href="<%= t.href %>"
           class="flex min-h-14 flex-col items-center justify-center gap-0.5 text-xs font-semibold no-underline <%= tabActive(t.href) ? 'text-accent-ink' : 'text-muted' %>"
           <%= tabActive(t.href) ? 'aria-current=page' : '' %>>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- t.icon %></svg>
          <%= t.label %>
        </a>
      </li>
    <% }) %>
  </ul>
</nav>
