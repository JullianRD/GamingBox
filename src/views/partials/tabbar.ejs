<%# Onglets mobiles : quatre destinations et l'ajout d'une œuvre au centre %>
<% const icon = (name, stroke = 1.8) => `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="${stroke}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${navIcons[name]}</svg>`;
   const tabs = navItems.filter((t) => t.tabbar !== false);
   const ordered = [tabs[0], tabs[1], { add: true }, tabs[2], tabs[3]]; %>
<nav aria-label="Navigation principale"
     class="fixed inset-x-0 bottom-0 z-50 border-t border-line-soft bg-surface/95 pb-[env(safe-area-inset-bottom)] backdrop-blur lg:hidden">
  <ul class="m-0 grid list-none grid-cols-5 items-center p-0">
    <% ordered.forEach((t) => { %>
      <li class="flex justify-center">
        <% if (t.add) { %>
          <a href="/recherche" aria-label="Ajouter une œuvre"
             class="-mt-5 flex h-14 w-14 items-center justify-center rounded-full bg-terracotta text-[#ffffff] no-underline shadow-[0_6px_16px_rgba(169,87,58,.35)] hover:text-[#ffffff]"><%- icon("add", 2.4) %></a>
        <% } else { %>
          <a href="<%= t.href %>" <%= t.active ? 'aria-current=page' : '' %>
             class="flex min-h-14 w-full flex-col items-center justify-center gap-0.5 text-xs font-bold no-underline <%= t.active ? 'text-accent-ink' : 'text-muted' %>">
            <span class="flex rounded-xl px-3.5 py-0.5 <%= t.active ? 'bg-peach' : '' %>"><%- icon(t.icon) %></span>
            <%= t.short || t.label %>
          </a>
        <% } %>
      </li>
    <% }) %>
  </ul>
</nav>
