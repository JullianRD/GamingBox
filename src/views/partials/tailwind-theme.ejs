/* =====================================================================
   Cocon - thème Tailwind
   Les vues ont été écrites pour un thème sombre (slate / purple / indigo).
   Plutôt que de réécrire chaque classe, on redéfinit ces palettes avec
   les teintes Cocon : la gamme slate est inversée (950 = fond crème,
   100 = texte brun), purple et indigo deviennent terracotta et pêche,
   et "white" devient la couleur de texte principale.
   Chargé par Tailwind (type="text/tailwindcss") dans layouts/main.ejs.
   ===================================================================== */
@theme {
  --font-sans: "Nunito", ui-sans-serif, system-ui, sans-serif;
  --font-serif: "Fraunces", Georgia, serif;

  --color-white: #3a2f2a;

  --color-slate-50: #2e2420;
  --color-slate-100: #3a2f2a;
  --color-slate-200: #4a3f39;
  --color-slate-300: #5a4e47;
  --color-slate-400: #6b5f57;
  --color-slate-500: #75665c;
  --color-slate-600: #cdbfb2;
  --color-slate-700: #e6dacd;
  --color-slate-800: #f3ece4;
  --color-slate-900: #fffdfa;
  --color-slate-950: #fbf7f2;

  --color-purple-100: #6a3b29;
  --color-purple-200: #7e3f28;
  --color-purple-300: #a9573a;
  --color-purple-400: #b8633f;
  --color-purple-500: #c4704f;
  --color-purple-600: #f0c9b6;
  --color-purple-700: #f4e1d6;
  --color-purple-800: #e9c3ae;
  --color-purple-900: #7e3f28;

  --color-indigo-400: #e3a88c;
  --color-indigo-500: #e8b49a;
  --color-indigo-600: #ebc0a8;

  --color-red-200: #8a2424;
  --color-red-300: #9b2c2c;
  --color-red-400: #b33a3a;
  --color-emerald-300: #2f6b3a;
  --color-yellow-300: #7a5a10;
  --color-amber-300: #7a5a10;
  --color-pink-300: #9a3d5e;

  /* Teintes de section, pour les futures pages Jeux / Films / Livres */
  --color-section-games: #dde7d8;
  --color-section-games-ink: #3e5a3a;
  --color-section-movies: #dce7f2;
  --color-section-movies-ink: #34536e;
  --color-section-books: #f3e3c3;
  --color-section-books-ink: #5c4518;

  --radius-lg: 0.75rem;
  --radius-xl: 1rem;
  --radius-2xl: 1.5rem;
}

@layer base {
  h1,
  h2,
  h3 {
    font-family: var(--font-serif);
    font-weight: 500;
  }
}
